{
  "name": "symphony-no-9",
  "version": "1.0.0",
  "description": "Symphony No. 9 audio player - Windows desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.symphony.no9.player",
    "productName": "Symphony No. 9",
    "directories": { "output": "dist" },
    "win": { "target": ["portable", "nsis"], "icon": "icon-256.png" },
    "files": ["main.js", "www/**/*", "icon-256.png"]
  }
}
